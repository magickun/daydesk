# 留空则本机不校验口令。放到公网前请设一串只有你知道的口令。
DAYDESK_TOKEN=

# --- 部署（二选一，见 README）---
# 方案 A：不设 DAYDESK_IMAGE，ECS 上 git pull && docker compose up -d --build
# 方案 B：本机 ./scripts/push-image.sh，ECS 上 ./scripts/ecs-update.sh
# DAYDESK_IMAGE=registry.cn-hangzhou.aliyuncs.com/<你的命名空间>/daydesk:latest

# 只有启用 https 配置时才会用到，写成你自己的域名，不要带 https://
DOMAIN=desk.example.com